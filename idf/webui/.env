# Digital-twin server URL.
# Leave empty (default) to disable server forwarding entirely.
# Example: http://192.168.1.100:8000
VITE_DIGITAL_TWIN_SERVER_URL=

# Upload chunk size: how many ECU batches per server upload
VITE_DT_CHUNK_SIZE=10

# In-flight window: max concurrent server upload chunks awaiting ack
VITE_DT_WINDOW=2
